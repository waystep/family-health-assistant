# ===== 企业微信自建应用（后台 myapp 里查看）=====
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
# 接收消息服务器配置里的 Token 和 EncodingAESKey
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ===== 大模型（OpenAI 兼容接口）=====
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=填你的智谱API Key
# 照片识别（需视觉能力），文本分析用；主视觉模型不可用时自动回落 LLM_VISION_FALLBACK
LLM_VISION_MODEL=glm-4v-flash
LLM_VISION_FALLBACK=glm-4v-flash
LLM_TEXT_MODEL=glm-4-flash

# ===== 飞书多维表格（可选，填了才同步）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 多维表格 app_token：打开表格，URL 里 /base/ 后面那段
FEISHU_BITABLE_APP_TOKEN=
# 血压表和体检表的 table_id：URL 里 ?table= 后面那段
FEISHU_BP_TABLE_ID=
FEISHU_CHECKUP_TABLE_ID=

# ===== 服务 =====
HOST=0.0.0.0
PORT=8901
