# ===== 基础 =====
# 接口令牌：微信桥/外部调用需携带 X-Token 或 ?token=
GATEWAY_TOKEN=change-me-please
# 网关端口
PORT=8900

# ===== 微信桥 =====
# 要监听的聊天（逗号分隔），消息将从这些会话进入网关
MONITOR_CHATS=文件传输助手
# 定时提醒/周报发送的目标会话（桥会主动发到这个会话）
TARGET_CHAT=文件传输助手

# ===== 提醒与周报 =====
# 每日测量提醒时间（24小时制，逗号分隔），留空关闭
REMINDER_TIMES=08:00,20:00
# 周报发送时间：周几(0=周一..6=周日) + HH:MM
REPORT_WEEKDAY=6
REPORT_TIME=20:30

# ===== 大模型（可选，用于自由文本兜底与照片识别）=====
# 任何 OpenAI 兼容接口均可，例如智谱: https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
# 不配大模型也能用：内置正则可解析常见说法（血压145/90、体重130斤等）
